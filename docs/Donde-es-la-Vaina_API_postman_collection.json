          "const match = pm.info.requestName.match(/ - (\\d{3})\\b/);",
          "const defaultCodes = { POST: 201, DELETE: 204 };",
          "const expectedCode = match ? Number(match[1]) : (defaultCodes[pm.request.method] || 200);",
          "pm.test(`${pm.info.requestName}: responde ${expectedCode}`, () => {",
